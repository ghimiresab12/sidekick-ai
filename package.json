{
  "name": "sidekick-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekick AI session engine, coordinator and reasoning integration (mock-only).",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.reasoning-compat.json",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "demo": "npm run build && node dist/src/mock/run-demo.js",
    "test:reasoning": "node --test \"tests/reasoning/*.test.mjs\"",
    "test:all": "npm test && npm run test:reasoning",
    "bridge": "npm run build && node --env-file-if-exists=.env dist/src/bridge/main.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
