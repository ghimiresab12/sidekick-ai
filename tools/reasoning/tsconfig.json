{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "types": ["node"], "typeRoots": ["./node_modules/@types"], "skipLibCheck": true
  },
  "include": ["../../src/reasoning/**/*.mts", "../../src/adapters/model/**/*.mts"]
}
