{
  "name": "sidekick-overlay",
  "private": true,
  "version": "0.1.0",
  "description": "Sidekick AI companion overlay UI, private local voice and session review. Client of the local Node bridge browser API; in-process simulation for development.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:simulation": "vite --mode simulation",
    "build": "tsc --noEmit && vite build",
    "build:simulation": "tsc --noEmit && vite build --mode simulation",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
