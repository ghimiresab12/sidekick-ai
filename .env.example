# Server-only. Copy to .env locally; .env is ignored. Never paste real credentials into source or chat.
GEMINI_API_KEY=
# Set a generateContent + structured-output model available to your account. No default is assumed.
GEMINI_MODEL=

# ── Sidekick HTTP bridge (server-only; never put these in browser/frontend code) ──
# REQUIRED. Python agent token: create sessions, read capture state, send transcripts/frames. ≥32 chars.
SIDEKICK_AGENT_TOKEN=
# REQUIRED. Operator/UI control token: consent, pause, resume, end, discard. ≥32 chars, different from the agent token.
SIDEKICK_CONTROL_TOKEN=
# Optional. Loopback port (the bridge always binds 127.0.0.1). Leave empty or remove for the default 8787.
SIDEKICK_BRIDGE_PORT=
# Optional. mock | gemini. Leave empty or remove for mock (offline simulator).
# gemini requires GEMINI_API_KEY and GEMINI_MODEL above; there is no fallback to mock.
SIDEKICK_REASONING=
# Optional. none | gemini. Leave empty or remove for none (frame uploads return 503).
# gemini sends each accepted frame to Gemini (billable) using GEMINI_API_KEY / GEMINI_MODEL above;
# it understands only the controlled-soccer-v1 simulation (docs/vision.md). No fallback.
SIDEKICK_VISION=
